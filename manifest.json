{
  "manifest_version": 3,
  "default_locale": "zh_CN",
  "name": "__MSG_extName__",
  "version": "1.0.2",
  "description": "__MSG_extDesc__",
  "permissions": [
    "storage",
    "activeTab",
    "downloads",
    "clipboardWrite",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://www.douyin.com/*",
    "https://*.douyin.com/*",
    "https://www.iesdouyin.com/*",
    "https://*.iesdouyin.com/*",
    "https://*.douyinvod.com/*",
    "https://*.douyincdn.com/*",
    "https://*.bytecdn.cn/*",
    "https://*.bytevod.com/*",
    "https://*.douyinpic.com/*",
    "https://*.byteimg.com/*",
    "https://*.snssdk.com/*",
    "https://*.amemv.com/*",
    "http://124.222.62.190:8081/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "douyin_cdn_headers",
        "enabled": true,
        "path": "rules/cdn-headers.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.douyin.com/*",
        "https://www.iesdouyin.com/*"
      ],
      "js": [
        "lib/aweme-parse.js",
        "content/page-agent.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.douyin.com/*",
        "https://www.iesdouyin.com/*"
      ],
      "js": [
        "shared/runtime.js",
        "shared/dom.js",
        "shared/debug-flag.js",
        "shared/debug.js",
        "shared/remote-content.js",
        "shared/notice.js",
        "shared/rating.js",
        "shared/panel.js",
        "shared/shell.js",
        "lib/aweme-parse.js",
        "lib/download-client.js",
        "lib/filename.js",
        "lib/download-settings.js",
        "content/content.js"
      ],
      "css": [
        "shared/panel.css",
        "content/content.css",
        "shared/design-system.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "抖音视频下载助手 - douyin",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon48.png",
        "icons/icon128.png",
        "assets/donate-wechat.jpg",
        "assets/donate-alipay.jpg",
        "shared/themes.json",
        "lib/aweme-parse.js",
        "content/page-agent.js"
      ],
      "matches": [
        "https://www.douyin.com/*",
        "https://www.iesdouyin.com/*"
      ]
    }
  ]
}
