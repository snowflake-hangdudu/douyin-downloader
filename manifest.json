{
  "manifest_version": 3,
  "name": "抖音下载助手",
  "version": "1.0.0",
  "description": "在抖音网页版单个视频页保存当前可访问的视频与封面。",
  "permissions": ["storage", "activeTab", "downloads", "declarativeNetRequest", "declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "https://www.douyin.com/*",
    "https://*.douyin.com/*",
    "https://www.iesdouyin.com/*",
    "https://*.iesdouyin.com/*",
    "https://*.douyinvod.com/*",
    "https://*.douyincdn.com/*",
    "https://*.bytecdn.cn/*",
    "https://*.bytevod.com/*",
    "https://*.douyinpic.com/*",
    "https://*.byteimg.com/*",
    "https://*.snssdk.com/*",
    "https://*.amemv.com/*",
    "https://download-config-hub.nutmeg-venus-6882.chatgpt.site/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "douyin_cdn_headers",
        "enabled": true,
        "path": "rules/cdn-headers.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.douyin.com/*",
        "https://www.iesdouyin.com/*"
      ],
      "js": ["lib/aweme-parse.js", "content/page-agent.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.douyin.com/*",
        "https://www.iesdouyin.com/*"
      ],
      "js": [
        "shared/runtime.js",
        "shared/dom.js",
        "shared/debug-flag.js",
        "shared/debug.js",
        "shared/remote-content.js",
        "shared/notice.js",
        "shared/rating.js",
        "shared/panel.js",
        "shared/shell.js",
        "lib/aweme-parse.js",
        "content/content.js"
      ],
      "css": ["shared/panel.css", "content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "抖音下载助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/icon48.png", "icons/icon128.png"],
      "matches": [
        "https://www.douyin.com/*",
        "https://www.iesdouyin.com/*"
      ]
    }
  ]
}
